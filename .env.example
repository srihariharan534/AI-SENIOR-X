# ==============================================================================
# AI-SENIOR-X Environment Configuration Template
# Copy this file to .env and adjust variables as required for your environment.
# NEVER commit .env with real secrets to source control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="AI-SENIOR-X"
API_V1_STR="/api/v1"

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
ALLOWED_HOSTS=["*"]

# CORS Origins (JSON list or comma-separated strings)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8000"]

# Database Configuration (PostgreSQL with asyncpg for async and psycopg2 for sync/migrations)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_senior_x
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_senior_x
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_senior_x
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# Security & Authentication
# Generate a secure 256-bit secret key in production (e.g., `openssl rand -hex 32`)
SECRET_KEY=dev-secret-key-change-in-production-must-be-at-least-32-chars!
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Logging & Monitoring
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_METRICS=true

# LLM & AI Engine Configuration (Extensible for Multi-Provider Architecture)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-pro
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
GROQ_API_KEY=your_groq_api_key_here
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=text-embedding-004

# Vector Database / RAG Knowledge Store
VECTOR_STORE_TYPE=pgvector
VECTOR_STORE_HOST=localhost
VECTOR_STORE_PORT=5432

# Frontend Configuration (Used by Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="AI-SENIOR-X"
